# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cliqtracker

# Redis
REDIS_URL=redis://localhost:6379
REDIS_LINK_CACHE_EXPIRY=3600

# Auth
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=dev
PAGE_SIZE=25

# Geo lookup
MMDB_PATH=GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=your-maxmind-license-key

# Rate limiting
LIMIT_COOKIE=30
LIMIT_API_KEY=60
LIMIT_UNAUTH=10
REFILL_COOKIE=0.5
REFILL_API_KEY=1.0
REFILL_UNAUTH=0.1

# Mail
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=Cliqtracker
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
